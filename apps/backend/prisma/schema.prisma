// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Phase 2: Customer & Measurement Profile Module

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum UserRole {
  SUPER_ADMIN // Platform-level — tenantId is null for this role
  SHOP_OWNER  // Admin of one Tenant
  STAFF       // Employee of one Tenant
}

enum InteractionSource {
  WALK_IN
  MARKETPLACE
  DIRECT
}

enum GarmentType {
  SHIRT
  PANT
  TSHIRT
  KURTA
  CUSTOM
}

enum MeasurementUnit {
  INCHES
  CM
}

enum FitPreference {
  SLIM
  REGULAR
  LOOSE
}

enum FabricStockTransactionType {
  PURCHASE
  RESERVE
  RELEASE
  CONSUME
  ADJUSTMENT
}

enum OrderStatus {
  PLACED
  MEASUREMENT_CONFIRMED
  CUTTING
  STITCHING
  QUALITY_CHECK
  READY
  DELIVERED
  CANCELLED
}

enum ListingStatus {
  PENDING_REVIEW
  APPROVED
  REJECTED
}

// ---------------------------------------------------------------------------
// Tenant (Shop)
// ---------------------------------------------------------------------------

model Tenant {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  /// URL-safe shop identifier. Used in staff login to scope the user lookup.
  slug      String   @unique
  isActive  Boolean  @default(true) @map("is_active")
  timezone  String   @default("Asia/Kolkata")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  users                      User[]
  shopCustomerLinks          ShopCustomerLink[]
  garmentTemplates           GarmentTemplate[]
  measurementProfiles        MeasurementProfile[]
  measurementProfileVersions MeasurementProfileVersion[]
  fabrics                    Fabric[]
  fabricStockTransactions    FabricStockTransaction[]
  orders                     Order[]
  orderStatusLogs            OrderStatusLog[]
  taxRatePercent             Decimal                     @default(0) @map("tax_rate_percent") @db.Decimal(5, 2)
  smsEnabled                 Boolean                     @default(true) @map("sms_enabled")
  emailEnabled               Boolean                     @default(true) @map("email_enabled")
  whatsappEnabled            Boolean                     @default(true) @map("whatsapp_enabled")
  allowsSelfMeasurement      Boolean                     @default(false) @map("allows_self_measurement")
  isListedOnMarketplace      Boolean                     @default(false) @map("is_listed_on_marketplace")
  listingStatus              ListingStatus               @default(PENDING_REVIEW) @map("listing_status")
  rejectionReason            String?                     @map("rejection_reason")
  city                       String?
  latitude                   Float?
  longitude                  Float?
  specialtyTags              String[]                    @default([]) @map("specialty_tags")
  coverPhotoUrl              String?                     @map("cover_photo_url")
  portfolioPhotoUrls         String[]                    @default([]) @map("portfolio_photo_urls")
  workingHours               Json?                       @map("working_hours")
  pricingRules               TenantPricingRule[]
  invoices                   Invoice[]
  invoicePayments            InvoicePayment[]
  notificationLogs           NotificationLog[]
  reviews                    CustomerReview[]
  subscriptions              TenantSubscription[]

  @@map("tenants")
}

// ---------------------------------------------------------------------------
// User (Staff / ShopOwner / SuperAdmin)
// ---------------------------------------------------------------------------

model User {
  id           String    @id @default(uuid()) @db.Uuid
  /// Null only for SUPER_ADMIN — all other roles require a tenant.
  tenantId     String?   @map("tenant_id") @db.Uuid
  email        String
  passwordHash String    @map("password_hash")
  role         UserRole
  firstName    String    @map("first_name")
  lastName     String    @map("last_name")
  isActive     Boolean   @default(true) @map("is_active")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  tenant                     Tenant?                     @relation(fields: [tenantId], references: [id])
  passwordResetTokens        PasswordResetToken[]
  measurementProfileVersions MeasurementProfileVersion[]
  fabricStockTransactions    FabricStockTransaction[]
  assignedOrders             Order[]                     @relation("AssignedOrders")
  orderStatusLogs            OrderStatusLog[]
  recordedPayments           InvoicePayment[]            @relation("RecordedPayments")

  /// Same email is allowed in different shops but must be unique within one shop.
  @@unique([tenantId, email])
  @@index([tenantId, isActive])
  @@map("users")
}

// ---------------------------------------------------------------------------
// Customer (Platform-global identity — NO tenant_id)
// ---------------------------------------------------------------------------

model Customer {
  id           String    @id @default(uuid()) @db.Uuid
  /// Primary identifier — unique across the platform
  phone        String    @unique
  /// Optional — unique when present
  email        String?   @unique
  /// Nullable — null means staff-created walk-in customer who has not self-registered yet
  passwordHash String?   @map("password_hash")
  firstName    String    @map("first_name")
  lastName     String    @map("last_name")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  shopLinks           ShopCustomerLink[]
  passwordResetTokens PasswordResetToken[]
  measurementProfiles MeasurementProfile[]
  orders              Order[]
  invoices            Invoice[]
  notificationLogs    NotificationLog[]
  reviews             CustomerReview[]

  @@map("customers")
}

// ---------------------------------------------------------------------------
// ShopCustomerLink — many-to-many bridge; carries tenant_id for RLS
// ---------------------------------------------------------------------------

model ShopCustomerLink {
  tenantId               String            @map("tenant_id") @db.Uuid
  customerId             String            @map("customer_id") @db.Uuid
  firstInteractionSource InteractionSource @map("first_interaction_source")
  joinedAt               DateTime          @default(now()) @map("joined_at")

  tenant   Tenant   @relation(fields: [tenantId], references: [id])
  customer Customer @relation(fields: [customerId], references: [id])

  @@id([tenantId, customerId])
  @@index([customerId])
  @@map("shop_customer_links")
}

// ---------------------------------------------------------------------------
// GarmentTemplate (Tenant-scoped measurement templates)
// ---------------------------------------------------------------------------

model GarmentTemplate {
  id          String      @id @default(uuid()) @db.Uuid
  tenantId    String      @map("tenant_id") @db.Uuid
  name        String
  garmentType GarmentType @map("garment_type")
  /// Array of field definitions: [{ name: string, description?: string }]
  fields      Json
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, garmentType])
  @@index([tenantId])
  @@map("garment_templates")
}

// ---------------------------------------------------------------------------
// MeasurementProfile (Tenant-scoped customer profile container)
// ---------------------------------------------------------------------------

model MeasurementProfile {
  id          String      @id @default(uuid()) @db.Uuid
  tenantId    String      @map("tenant_id") @db.Uuid
  customerId  String      @map("customer_id") @db.Uuid
  name        String      /// e.g. "Self", "Son - Raj"
  garmentType GarmentType @map("garment_type")
  notes       String?
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  tenant   Tenant                      @relation(fields: [tenantId], references: [id])
  customer Customer                    @relation(fields: [customerId], references: [id])
  versions MeasurementProfileVersion[]
  orders   Order[]

  @@index([tenantId, customerId])
  @@map("measurement_profiles")
}

// ---------------------------------------------------------------------------
// MeasurementProfileVersion (Mandatory version history — immutable values)
// ---------------------------------------------------------------------------

model MeasurementProfileVersion {
  id            String          @id @default(uuid()) @db.Uuid
  tenantId      String          @map("tenant_id") @db.Uuid
  profileId     String          @map("profile_id") @db.Uuid
  versionNumber Int             @map("version_number")
  isCurrent     Boolean         @default(true) @map("is_current")
  /// Field-value map: { "Chest": 40.5, "Waist": 34, ... }
  values        Json
  unit          MeasurementUnit @default(INCHES)
  fitPreference FitPreference   @default(REGULAR) @map("fit_preference")
  fitNotes      String?         @map("fit_notes")
  photoUrl      String?         @map("photo_url")
  createdById   String          @map("created_by_id") @db.Uuid
  createdAt     DateTime        @default(now()) @map("created_at")

  tenant    Tenant             @relation(fields: [tenantId], references: [id])
  profile   MeasurementProfile @relation(fields: [profileId], references: [id])
  createdBy User               @relation(fields: [createdById], references: [id])

  @@unique([profileId, versionNumber])
  @@index([tenantId, profileId])
  @@map("measurement_profile_versions")
}

// ---------------------------------------------------------------------------
// PasswordResetToken
// ---------------------------------------------------------------------------

model PasswordResetToken {
  id         String    @id @default(uuid()) @db.Uuid
  /// SHA-256 hash of the plaintext token. Plaintext is never stored.
  tokenHash  String    @unique @map("token_hash")
  /// Set for Staff / Owner resets. Exactly one of userId / customerId must be non-null.
  userId     String?   @map("user_id") @db.Uuid
  /// Set for Customer resets.
  customerId String?   @map("customer_id") @db.Uuid
  expiresAt  DateTime  @map("expires_at")
  usedAt     DateTime? @map("used_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  user     User?     @relation(fields: [userId], references: [id])
  customer Customer? @relation(fields: [customerId], references: [id])

  @@index([userId])
  @@index([customerId])
  @@map("password_reset_tokens")
}

// ---------------------------------------------------------------------------
// Fabric (Tenant-scoped fabric inventory item)
// ---------------------------------------------------------------------------

model Fabric {
  id                 String   @id @default(uuid()) @db.Uuid
  tenantId           String   @map("tenant_id") @db.Uuid
  name               String
  color              String
  type               String   /// e.g. "Cotton", "Linen", "Silk"
  pricePerMeter      Decimal  @map("price_per_meter") @db.Decimal(10, 2)
  availableMeters    Decimal  @default(0) @map("available_meters") @db.Decimal(12, 3)
  reservedMeters     Decimal  @default(0) @map("reserved_meters") @db.Decimal(12, 3)
  lowStockThreshold  Decimal  @default(0) @map("low_stock_threshold") @db.Decimal(12, 3)
  isArchived         Boolean  @default(false) @map("is_archived")
  photoUrl           String?  @map("photo_url")
  supplierName       String?  @map("supplier_name")
  purchaseNotes      String?  @map("purchase_notes")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  tenant             Tenant                   @relation(fields: [tenantId], references: [id])
  transactions       FabricStockTransaction[]
  orders             Order[]

  @@index([tenantId])
  @@index([tenantId, isArchived])
  @@map("fabrics")
}

// ---------------------------------------------------------------------------
// FabricStockTransaction (Append-only stock ledger — never updated or deleted)
// ---------------------------------------------------------------------------

model FabricStockTransaction {
  id             String                     @id @default(uuid()) @db.Uuid
  tenantId       String                     @map("tenant_id") @db.Uuid
  fabricId       String                     @map("fabric_id") @db.Uuid
  type           FabricStockTransactionType
  meters         Decimal                    @db.Decimal(12, 3)
  relatedOrderId String?                    @map("related_order_id") @db.Uuid
  note           String?
  createdById    String                     @map("created_by_id") @db.Uuid
  createdAt      DateTime                   @default(now()) @map("created_at")

  tenant         Tenant                     @relation(fields: [tenantId], references: [id])
  fabric         Fabric                     @relation(fields: [fabricId], references: [id])
  createdBy      User                       @relation(fields: [createdById], references: [id])

  @@index([tenantId, fabricId])
  @@index([fabricId, createdAt])
  @@map("fabric_stock_transactions")
}

// ---------------------------------------------------------------------------
// Order (Tenant-scoped custom tailoring order)
// ---------------------------------------------------------------------------

model Order {
  id                   String      @id @default(uuid()) @db.Uuid
  tenantId             String      @map("tenant_id") @db.Uuid
  customerId           String      @map("customer_id") @db.Uuid
  measurementProfileId String      @map("measurement_profile_id") @db.Uuid
  fabricId             String      @map("fabric_id") @db.Uuid
  garmentType          GarmentType @map("garment_type")
  metersUsed           Decimal     @map("meters_used") @db.Decimal(12, 3)
  status               OrderStatus @default(PLACED)
  assignedStaffId      String?     @map("assigned_staff_id") @db.Uuid
  priceSnapshot        Decimal     @map("price_snapshot") @db.Decimal(10, 2)
  estimatedDeliveryDate DateTime?  @map("estimated_delivery_date")
  notes                String?
  createdAt            DateTime    @default(now()) @map("created_at")
  updatedAt            DateTime    @updatedAt @map("updated_at")

  tenant               Tenant             @relation(fields: [tenantId], references: [id])
  customer             Customer           @relation(fields: [customerId], references: [id])
  measurementProfile   MeasurementProfile @relation(fields: [measurementProfileId], references: [id])
  fabric               Fabric             @relation(fields: [fabricId], references: [id])
  assignedStaff        User?              @relation("AssignedOrders", fields: [assignedStaffId], references: [id])
  statusLogs           OrderStatusLog[]
  invoices             Invoice[]
  notificationLogs     NotificationLog[]
  review               CustomerReview?

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, customerId])
  @@index([tenantId, assignedStaffId])
  @@map("orders")
}

// ---------------------------------------------------------------------------
// OrderStatusLog (Append-only lifecycle audit log)
// ---------------------------------------------------------------------------

model OrderStatusLog {
  id          String       @id @default(uuid()) @db.Uuid
  tenantId    String       @map("tenant_id") @db.Uuid
  orderId     String       @map("order_id") @db.Uuid
  fromStatus  OrderStatus? @map("from_status")
  toStatus    OrderStatus  @map("to_status")
  changedById String       @map("changed_by_id") @db.Uuid
  changedAt   DateTime     @default(now()) @map("changed_at")
  note        String?

  tenant      Tenant       @relation(fields: [tenantId], references: [id])
  order       Order        @relation(fields: [orderId], references: [id])
  changedBy   User         @relation(fields: [changedById], references: [id])

  @@index([tenantId, orderId])
  @@index([orderId, changedAt])
  @@map("order_status_logs")
}

// ---------------------------------------------------------------------------
// Phase 7A: Invoicing & Pricing Rules
// ---------------------------------------------------------------------------

enum InvoiceStatus {
  DRAFT
  ISSUED
  PARTIALLY_PAID
  PAID
  VOID
}

enum PaymentMethod {
  CASH
  UPI_MANUAL
  BANK_TRANSFER
  GATEWAY
}

model TenantPricingRule {
  id              String       @id @default(uuid()) @db.Uuid
  tenantId        String       @map("tenant_id") @db.Uuid
  garmentType     GarmentType  @map("garment_type")
  stitchingCharge Decimal      @map("stitching_charge") @db.Decimal(10, 2)
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")

  tenant          Tenant       @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, garmentType])
  @@index([tenantId])
  @@map("tenant_pricing_rules")
}

model Invoice {
  id              String         @id @default(uuid()) @db.Uuid
  tenantId        String         @map("tenant_id") @db.Uuid
  invoiceNumber   String         @map("invoice_number")
  orderId         String         @map("order_id") @db.Uuid
  customerId      String         @map("customer_id") @db.Uuid

  fabricCost      Decimal        @map("fabric_cost") @db.Decimal(10, 2)
  stitchingCharge Decimal        @map("stitching_charge") @db.Decimal(10, 2)
  urgentSurcharge Decimal        @default(0) @map("urgent_surcharge") @db.Decimal(10, 2)
  taxRatePercent  Decimal        @default(0) @map("tax_rate_percent") @db.Decimal(5, 2)
  taxAmount       Decimal        @map("tax_amount") @db.Decimal(10, 2)
  totalAmount     Decimal        @map("total_amount") @db.Decimal(10, 2)

  advancePaid     Decimal        @default(0) @map("advance_paid") @db.Decimal(10, 2)
  balanceDue      Decimal        @map("balance_due") @db.Decimal(10, 2)

  status          InvoiceStatus  @default(ISSUED)
  notes           String?
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  tenant          Tenant         @relation(fields: [tenantId], references: [id])
  order           Order          @relation(fields: [orderId], references: [id])
  customer        Customer       @relation(fields: [customerId], references: [id])
  payments        InvoicePayment[]

  @@unique([tenantId, invoiceNumber])
  @@index([tenantId])
  @@index([tenantId, orderId])
  @@index([tenantId, customerId])
  @@index([tenantId, status])
  @@map("invoices")
}

model InvoicePayment {
  id            String        @id @default(uuid()) @db.Uuid
  tenantId      String        @map("tenant_id") @db.Uuid
  invoiceId     String        @map("invoice_id") @db.Uuid
  amount               Decimal       @db.Decimal(10, 2)
  paymentMethod        PaymentMethod @default(CASH) @map("payment_method")
  gatewayTransactionId String?       @map("gateway_transaction_id")
  reference            String?
  notes                String?
  recordedById         String        @map("recorded_by_id") @db.Uuid
  recordedAt    DateTime      @default(now()) @map("recorded_at")

  tenant        Tenant        @relation(fields: [tenantId], references: [id])
  invoice       Invoice       @relation(fields: [invoiceId], references: [id])
  recordedBy    User          @relation("RecordedPayments", fields: [recordedById], references: [id])

  @@index([tenantId, invoiceId])
  @@map("invoice_payments")
}

// ---------------------------------------------------------------------------
// Phase 8: Notifications
// ---------------------------------------------------------------------------

enum NotificationChannel {
  SMS
  EMAIL
  WHATSAPP
  IN_APP
}

enum NotificationStatus {
  QUEUED
  SENT
  FAILED
}

model NotificationLog {
  id           String             @id @default(uuid()) @db.Uuid
  tenantId     String             @map("tenant_id") @db.Uuid
  customerId   String?            @map("customer_id") @db.Uuid
  orderId      String?            @map("order_id") @db.Uuid
  channel      NotificationChannel
  templateName String             @map("template_name")
  status       NotificationStatus @default(QUEUED)
  payload      Json
  errorMessage String?            @map("error_message")
  createdAt    DateTime           @default(now()) @map("created_at")
  updatedAt    DateTime           @updatedAt @map("updated_at")

  tenant       Tenant             @relation(fields: [tenantId], references: [id])
  customer     Customer?          @relation(fields: [customerId], references: [id])
  order        Order?             @relation(fields: [orderId], references: [id])

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, customerId])
  @@index([tenantId, orderId])
  @@map("notification_logs")
}

// ---------------------------------------------------------------------------
// CustomerReview (Verified customer review on completed DELIVERED orders)
// ---------------------------------------------------------------------------

model CustomerReview {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  customerId  String   @map("customer_id") @db.Uuid
  orderId     String   @unique @map("order_id") @db.Uuid
  rating      Int
  comment     String?
  isFlagged   Boolean  @default(false) @map("is_flagged")
  flagReason  String?  @map("flag_reason")
  flaggedBy   String?  @map("flagged_by")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  order    Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([tenantId, isFlagged])
  @@index([customerId])
  @@map("customer_reviews")
}

// ---------------------------------------------------------------------------
// Phase 11: Subscriptions, Plans & Payments (Platform Owner & Super Admin)
// ---------------------------------------------------------------------------

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  CANCELLED
  EXPIRED
}

enum SubscriptionBillingCycle {
  MONTHLY
  YEARLY
}

enum SubscriptionPaymentMethod {
  CASH
  BANK_TRANSFER
  UPI
  CHEQUE
  GATEWAY
}

model SubscriptionPlan {
  id                String   @id @default(uuid()) @db.Uuid
  name              String   @unique
  priceMonthly      Decimal  @map("price_monthly") @db.Decimal(10, 2)
  priceYearly       Decimal  @map("price_yearly") @db.Decimal(10, 2)
  maxStaffAccounts  Int      @map("max_staff_accounts")
  maxOrdersPerMonth Int      @map("max_orders_per_month")
  maxSmsCredits     Int      @default(100) @map("max_sms_credits")
  features          Json     @default("[]")
  isActive          Boolean  @default(true) @map("is_active")
  isDefault         Boolean  @default(false) @map("is_default")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  subscriptions     TenantSubscription[]

  @@map("subscription_plans")
}

model TenantSubscription {
  id                 String                     @id @default(uuid()) @db.Uuid
  tenantId           String                     @map("tenant_id") @db.Uuid
  planId             String                     @map("plan_id") @db.Uuid
  status             SubscriptionStatus         @default(TRIAL)
  billingCycle       SubscriptionBillingCycle   @default(MONTHLY) @map("billing_cycle")
  currentPeriodStart DateTime                   @default(now()) @map("current_period_start")
  currentPeriodEnd   DateTime                   @map("current_period_end")
  trialEndsAt        DateTime?                  @map("trial_ends_at")
  cancelledAt        DateTime?                  @map("cancelled_at")
  pendingPlanId      String?                    @map("pending_plan_id") @db.Uuid
  createdAt          DateTime                   @default(now()) @map("created_at")
  updatedAt          DateTime                   @updatedAt @map("updated_at")

  tenant             Tenant                     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan               SubscriptionPlan           @relation(fields: [planId], references: [id])
  payments           TenantSubscriptionPayment[]

  @@index([tenantId, status])
  @@map("tenant_subscriptions")
}

model TenantSubscriptionPayment {
  id               String                    @id @default(uuid()) @db.Uuid
  subscriptionId   String                    @map("subscription_id") @db.Uuid
  tenantId         String                    @map("tenant_id") @db.Uuid
  amount           Decimal                   @db.Decimal(10, 2)
  paymentMethod    SubscriptionPaymentMethod @map("payment_method")
  referenceNote    String?                   @map("reference_note")
  periodStart      DateTime                  @map("period_start")
  periodEnd        DateTime                  @map("period_end")
  recordedAt       DateTime                  @default(now()) @map("recorded_at")
  recordedByUserId String?                   @map("recorded_by_user_id") @db.Uuid

  subscription     TenantSubscription        @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("tenant_subscription_payments")
}

