{
  "name": "darzi-desk",
  "version": "0.1.0",
  "private": true,
  "description": "DarziDesk — The Intelligent Operating System & Bespoke Atelier Management Platform for Modern Tailors",
  "author": "Viraj Savaliya <enquiry.virajsavaliya@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/virajsavaliya/DarziDesk.git"
  },
  "homepage": "https://github.com/virajsavaliya/DarziDesk#readme",
  "engines": {
    "node": ">=20.0.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "docker compose up -d postgres && concurrently -n backend,frontend -c blue,magenta \"npm run dev:backend\" \"npm run dev:frontend\"",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "dev:backend": "npm run dev --workspace=apps/backend",
    "dev:frontend": "npm run dev --workspace=apps/frontend",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:status": "docker compose ps"
  },
  "overrides": {
    "express": {
      "qs": "^6.16.0"
    }
  },
  "devDependencies": {
    "concurrently": "^10.0.5",
    "playwright": "^1.63.0"
  }
}
